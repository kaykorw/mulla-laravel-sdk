{
    "name": "kayko/mulla-laravel",
    "description": "Official Laravel integration for the Mulla payment gateway (MTN MoMo & Airtel Money, Rwanda).",
    "type": "library",
    "license": "MIT",
    "keywords": ["mulla", "laravel", "payments", "mobile money", "momo", "mtn", "airtel", "rwanda", "webhooks"],
    "homepage": "https://github.com/kaykorw/mulla-laravel-sdk",
    "require": {
        "php": ">=8.1",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "kayko/mulla-php": "^0.0.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^2.9 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mulla\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mulla\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mulla\\Laravel\\MullaServiceProvider"
            ],
            "aliases": {
                "Mulla": "Mulla\\Laravel\\Facades\\Mulla"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
