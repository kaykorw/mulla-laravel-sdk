includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # InteractsWithMulla is used by applications' test cases, not inside this package.
        -
            identifier: trait.unused
            path: src/Testing/InteractsWithMulla.php
